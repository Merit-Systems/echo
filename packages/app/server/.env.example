# ============================================================
# Echo Server - Environment Variables
# ============================================================
# For local development, run `pnpm setup` from the repo root.
# It generates a working .env automatically.
# ============================================================

# --- Server ---
PORT=3069

# --- Database ---
# Must point to the same Postgres as Echo Control
DATABASE_URL="postgresql://echo_user:echo_password@localhost:5469/echo_control_v2?schema=public"

# --- Control Plane ---
ECHO_CONTROL_BASE_URL=http://localhost:3000/

# --- LLM Provider API Keys ---
# Add the keys for providers you want to use. All are optional.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Echo API Key (optional) ---
ECHO_API_KEY=

# --- OAuth ---
# Must match OAUTH_JWT_SECRET in control's .env
OAUTH_JWT_SECRET="local-dev-jwt-secret"

# --- Telemetry (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=echo-server

# --- Stripe (optional for local dev) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- x402 (optional) ---
MAX_OUTPUT_TOKENS=4096
ECHO_ROUTER_BASE_URL=
FACILITATOR_BASE_URL=
NETWORK=base-sepolia
